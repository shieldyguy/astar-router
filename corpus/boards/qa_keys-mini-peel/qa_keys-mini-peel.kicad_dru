(version 1)
# DipTrace's DRC clearance table, one rule per object pair (pcb pull)
(rule "Copper to board" (condition "A.Type == 'Zone'") (constraint edge_clearance (min 0.4573mm)))
(rule "Copper to Copper" (condition "A.Type == 'Zone' && B.Type == 'Zone'") (constraint clearance (min 0.1270mm)))
(rule "Copper to drill" (condition "A.Type == 'Zone'") (constraint hole_clearance (min 0.1270mm)))
(rule "drill to drill" (constraint hole_to_hole (min 0.1270mm)))
(rule "Pad to board" (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'") (constraint edge_clearance (min 0.4573mm)))
(rule "Pad to Copper" (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Type == 'Zone'") (constraint clearance (min 0.1270mm)))
(rule "Pad to drill" (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'") (constraint hole_clearance (min 0.1270mm)))
(rule "Pad to Pad" (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Type == 'Pad' && B.Pad_Type == 'Through-hole'") (constraint clearance (min 0.1270mm)))
(rule "Pad to Smd" (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && B.Type == 'Pad' && B.Pad_Type == 'SMD'") (constraint clearance (min 0.1270mm)))
(rule "Smd to board" (condition "A.Type == 'Pad' && A.Pad_Type == 'SMD'") (constraint edge_clearance (min 0.4573mm)))
(rule "Smd to Copper" (condition "A.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Type == 'Zone'") (constraint clearance (min 0.1270mm)))
(rule "Smd to drill" (condition "A.Type == 'Pad' && A.Pad_Type == 'SMD'") (constraint hole_clearance (min 0.1270mm)))
(rule "Smd to Smd" (condition "A.Type == 'Pad' && A.Pad_Type == 'SMD' && B.Type == 'Pad' && B.Pad_Type == 'SMD'") (constraint clearance (min 0.1270mm)))
(rule "Trace to board" (condition "A.Type == 'Track'") (constraint edge_clearance (min 0.2540mm)))
(rule "Trace to Copper" (condition "A.Type == 'Track' && B.Type == 'Zone'") (constraint clearance (min 0.1270mm)))
(rule "Trace to drill" (condition "A.Type == 'Track'") (constraint hole_clearance (min 0.1270mm)))
(rule "Trace to Pad" (condition "A.Type == 'Track' && B.Type == 'Pad' && B.Pad_Type == 'Through-hole'") (constraint clearance (min 0.1270mm)))
(rule "Trace to Smd" (condition "A.Type == 'Track' && B.Type == 'Pad' && B.Pad_Type == 'SMD'") (constraint clearance (min 0.1270mm)))
(rule "Trace to Trace" (condition "A.Type == 'Track' && B.Type == 'Track'") (constraint clearance (min 0.1270mm)))
(rule "Trace to Via" (condition "A.Type == 'Track' && B.Type == 'Via'") (constraint clearance (min 0.1270mm)))
(rule "Via to board" (condition "A.Type == 'Via'") (constraint edge_clearance (min 0.4573mm)))
(rule "Via to Copper" (condition "A.Type == 'Via' && B.Type == 'Zone'") (constraint clearance (min 0.1270mm)))
(rule "Via to drill" (condition "A.Type == 'Via'") (constraint hole_clearance (min 0.1270mm)))
(rule "Via to Pad" (condition "A.Type == 'Via' && B.Type == 'Pad' && B.Pad_Type == 'Through-hole'") (constraint clearance (min 0.1270mm)))
(rule "Via to Smd" (condition "A.Type == 'Via' && B.Type == 'Pad' && B.Pad_Type == 'SMD'") (constraint clearance (min 0.1270mm)))
(rule "Via to Via" (condition "A.Type == 'Via' && B.Type == 'Via'") (constraint clearance (min 0.1270mm)))
