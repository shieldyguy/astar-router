(version 1)
(rule "U1 LQFP-64 0.5 pitch escape"
  (condition "A.memberOfFootprint('U1') || B.memberOfFootprint('U1')")
  (constraint clearance (min 0.127mm)))
(rule "U4 QFN-32 0.5 pitch escape"
  (condition "A.memberOfFootprint('U4') || B.memberOfFootprint('U4')")
  (constraint clearance (min 0.127mm)))
(rule "J1 USB-C 0.5 pitch pad row"
  (condition "A.memberOfFootprint('J1') || B.memberOfFootprint('J1')")
  (constraint clearance (min 0.127mm)))
